---
interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div
    data-testid="empty-state"
    class="netflix-empty-state text-center py-12 backdrop-blur-sm rounded-xl border"
>
    {text ? (
        <p data-testid="empty-state-text" class="netflix-muted">{text}</p>
    ) : (
        <slot />
    )}
</div>
