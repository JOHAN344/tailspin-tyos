---
interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="max-w-3xl mb-10" data-testid="page-hero">
    <h1 class="netflix-card-title text-4xl font-bold mb-4" data-testid="page-hero-title">{title}</h1>
    {subtitle && (
        <p class="netflix-muted text-xl" data-testid="page-hero-subtitle">{subtitle}</p>
    )}
    <slot />
</div>
